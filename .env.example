# Which MangaProvider implementation to use (see lib/providers/index.ts)
MANGA_PROVIDER=keikomik

# Firebase project ID of the content source's Firestore database
KEIKOMIK_PROJECT_ID=your-firebase-project-id

# Client-side Firebase API key of the content source (public web key)
KEIKOMIK_API_KEY=your-firebase-web-api-key

# Canonical base URL of this deployment
NEXT_PUBLIC_BASE_URL=http://localhost:3000
